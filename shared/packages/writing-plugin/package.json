{
  "name": "@jizuo/writing-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@jizuo/plugin",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jizuo/contracts": "workspace:*",
    "@jizuo/work-domain": "workspace:*",
    "@jizuo/memory-domain": "workspace:*",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "react": "18.3.1"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "@types/react": "18.3.27"
  }
}
